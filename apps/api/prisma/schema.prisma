generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm, postgis, uuid_ossp(map: "uuid-ossp", schema: "extensions")]
}

model Space {
  id              String           @id @default(cuid())
  name            String
  brands          Brand[]
  collections     Collection[]
  places          Place[]
  recommendations Recommendation[]
  keywords        SearchKeyword[]
  members         SpaceMember[]

  @@map("space")
}

model User {
  id                     String           @id @default(cuid())
  name                   String
  email                  String           @unique
  avatarUrl              String?          @map("avatar_url")
  experiences            Experience[]
  createdPlaces          Place[]          @relation("PlaceCreatedBy")
  updatedPlaces          Place[]          @relation("PlaceUpdatedBy")
  createdRecommendations Recommendation[] @relation("RecCreatedBy")
  updatedRecommendations Recommendation[] @relation("RecUpdatedBy")
  memberships            SpaceMember[]
  createdShareCodes      RecommendationShareCode[]

  @@map("app_user")
}

model SpaceMember {
  id      String    @id @default(cuid())
  spaceId String    @map("space_id")
  userId  String    @map("user_id")
  role    SpaceRole @default(MEMBER)
  space   Space     @relation(fields: [spaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user    User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([spaceId, userId])
  @@map("space_member")
}

/// AGGREGATE ROOT — ver ADR-001
model Recommendation {
  id                 String                     @id @default(cuid())
  spaceId            String                     @map("space_id")
  name               String
  description        String?
  categoryId         String?                    @map("category_id")
  brandId            String?                    @map("brand_id")
  status             RecommendationStatus       @default(EXPERIENCED)
  verdict            Verdict?
  rating             Decimal?                   @db.Decimal(2, 1)
  firstExperiencedAt DateTime?                  @map("first_experienced_at")
  lastExperiencedAt  DateTime?                  @map("last_experienced_at")
  searchVector       Unsupported("tsvector")?   @map("search_vector")
  createdById        String                     @map("created_by_id")
  updatedById        String                     @map("updated_by_id")
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @default(now()) @updatedAt @map("updated_at")
  sourceLabel        String?                    @map("source_label")
  collections        CollectionRecommendation[]
  experiences        Experience[]
  photos             Photo[]
  purchaseLinks      PurchaseLink[]
  brand              Brand?                     @relation(fields: [brandId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  category           RecommendationCategory?    @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy          User                       @relation("RecCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  space              Space                      @relation(fields: [spaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updatedBy          User                       @relation("RecUpdatedBy", fields: [updatedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  keywords           RecommendationKeyword[]
  places             RecommendationPlace[]

  @@index([spaceId])
  @@index([name(ops: raw("gin_trgm_ops"))], map: "recommendation_name_trgm_idx", type: Gin)
  @@index([searchVector], type: Gin)
  shareCodes         RecommendationShareCode[]

  @@map("recommendation")
}

model RecommendationShareCode {
  id               String         @id @default(cuid())
  code             String         @unique
  recommendationId String         @map("recommendation_id")
  createdById      String         @map("created_by_id")
  createdAt        DateTime       @default(now()) @map("created_at")
  expiresAt        DateTime       @map("expires_at")
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdBy        User           @relation(fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([recommendationId])
  @@map("recommendation_share_code")
}
model RecommendationCategory {
  id              String           @id @default(cuid())
  name            String           @unique
  icon            String?
  recommendations Recommendation[]

  @@map("recommendation_category")
}

/// junção N:N Recommendation<->Place — preço vive aqui (ADR-001 decisão 3)
model RecommendationPlace {
  id               String         @id @default(cuid())
  recommendationId String         @map("recommendation_id")
  placeId          String         @map("place_id")
  lastPrice        Decimal?       @map("last_price") @db.Money
  notes            String?
  createdAt        DateTime       @default(now()) @map("created_at")
  priceHistory     PriceEntry[]
  place            Place          @relation(fields: [placeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@unique([recommendationId, placeId])
  @@map("recommendation_place")
}

model PriceEntry {
  id                    String              @id @default(cuid())
  recommendationPlaceId String              @map("recommendation_place_id")
  price                 Decimal             @db.Money
  paidAt                DateTime            @default(now()) @map("paid_at")
  recommendationPlace   RecommendationPlace @relation(fields: [recommendationPlaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("price_entry")
}

model PurchaseLink {
  id               String           @id @default(cuid())
  recommendationId String           @map("recommendation_id")
  label            String
  url              String
  kind             PurchaseLinkKind @default(OTHER)
  recommendation   Recommendation   @relation(fields: [recommendationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("purchase_link")
}

model Place {
  id              String                    @id @default(cuid())
  spaceId         String                    @map("space_id")
  name            String
  categoryId      String?                   @map("category_id")
  address         String?
  neighborhood    String?
  city            String?
  state           String?
  zipCode         String?                   @map("zip_code")
  latitude        Float?
  longitude       Float?
  geom            Unsupported("geography")?
  phone           String?
  whatsapp        String?
  instagram       String?
  website         String?
  openingHours    Json?                     @map("opening_hours")
  notes           String?
  createdById     String                    @map("created_by_id")
  updatedById     String                    @map("updated_by_id")
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @default(now()) @updatedAt @map("updated_at")
  experiences     Experience[]
  photos          Photo[]
  category        PlaceCategory?            @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy       User                      @relation("PlaceCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  space           Space                     @relation(fields: [spaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updatedBy       User                      @relation("PlaceUpdatedBy", fields: [updatedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recommendations RecommendationPlace[]

  @@index([spaceId])
  @@index([geom], type: Gist)
  @@index([name(ops: raw("gin_trgm_ops"))], map: "place_name_trgm_idx", type: Gin)
  @@map("place")
}

model PlaceCategory {
  id     String  @id @default(cuid())
  name   String  @unique
  icon   String?
  places Place[]

  @@map("place_category")
}

model Brand {
  id              String           @id @default(cuid())
  spaceId         String           @map("space_id")
  name            String
  logoUrl         String?          @map("logo_url")
  website         String?
  space           Space            @relation(fields: [spaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recommendations Recommendation[]

  @@unique([spaceId, name])
  @@index([spaceId])
  @@map("brand")
}

model Collection {
  id              String                     @id @default(cuid())
  spaceId         String                     @map("space_id")
  name            String
  icon            String?
  description     String?
  createdAt       DateTime                   @default(now()) @map("created_at")
  space           Space                      @relation(fields: [spaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recommendations CollectionRecommendation[]

  @@unique([spaceId, name])
  @@index([spaceId])
  @@map("collection")
}

model CollectionRecommendation {
  collectionId     String         @map("collection_id")
  recommendationId String         @map("recommendation_id")
  collection       Collection     @relation(fields: [collectionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([collectionId, recommendationId])
  @@map("collection_recommendation")
}

model SearchKeyword {
  id              String                  @id @default(cuid())
  spaceId         String                  @map("space_id")
  label           String
  recommendations RecommendationKeyword[]
  space           Space                   @relation(fields: [spaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([spaceId, label])
  @@index([spaceId])
  @@map("search_keyword")
}

model RecommendationKeyword {
  recommendationId String         @map("recommendation_id")
  keywordId        String         @map("keyword_id")
  keyword          SearchKeyword  @relation(fields: [keywordId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([recommendationId, keywordId])
  @@map("recommendation_keyword")
}

model Experience {
  id               String         @id @default(cuid())
  recommendationId String         @map("recommendation_id")
  placeId          String?        @map("place_id")
  authorId         String         @map("author_id")
  rating           Int
  comment          String?
  visitedAt        DateTime       @default(now()) @map("visited_at")
  author           User           @relation(fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  place            Place?         @relation(fields: [placeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("experience")
}

model Photo {
  id               String          @id @default(cuid())
  url              String
  kind             String
  placeId          String?         @map("place_id")
  recommendationId String?         @map("recommendation_id")
  createdAt        DateTime        @default(now()) @map("created_at")
  place            Place?          @relation(fields: [placeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recommendation   Recommendation? @relation(fields: [recommendationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("photo")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

enum Verdict {
  RECOMMEND
  EMERGENCY_ONLY
  NOT_RECOMMEND
}

enum RecommendationStatus {
  WANT_TO_TRY
  EXPERIENCED
  DISCARDED
}

enum SpaceRole {
  OWNER
  MEMBER
}

enum PurchaseLinkKind {
  MARKETPLACE
  OFFICIAL_WEBSITE
  OTHER
}
